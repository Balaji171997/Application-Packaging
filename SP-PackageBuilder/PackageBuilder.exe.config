<?xml version="1.0" encoding="utf-8"?>
<!--
  Package Builder launcher config  -  ships NEXT TO PackageBuilder.exe (same folder, on the share).
  Two jobs:
   1) Let the tool load binary modules (ConfigMgr / Intune MSAL.PS) when run FROM A NETWORK SHARE
      (loadFromRemoteSources) - otherwise .NET can refuse assemblies from a UNC/Internet-zone path.
   2) Let .NET handle LONG PATHS (>260 chars) instead of throwing PathTooLongException, on Windows
      builds where long paths are enabled (Win10 1607+ with the LongPathsEnabled policy/registry).
  Completely harmless when running locally or from a trusted (Local Intranet) share.
  Keep this file beside the exe. .NET reads "<exeName>.exe.config" automatically at startup.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true" />
    <!-- Opt in to modern (long-path-capable) path handling for System.IO. -->
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
  </runtime>
</configuration>
