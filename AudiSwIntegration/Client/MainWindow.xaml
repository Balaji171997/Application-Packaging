<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audi SCCM Integration Tool" MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="#FF00191F"
        FontFamily="Segoe UI" FontSize="13"
        SizeToContent="Manual" ResizeMode="CanResize" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>

    <!-- ===================================================== palette -->
    <SolidColorBrush x:Key="Bg"          Color="#FF00191F"/>
    <SolidColorBrush x:Key="Card"        Color="#FF042A33"/>
    <SolidColorBrush x:Key="CardBorder"  Color="#FF0E4552"/>
    <SolidColorBrush x:Key="Field"       Color="#FF00232B"/>
    <SolidColorBrush x:Key="FieldBorder" Color="#FF17434E"/>
    <SolidColorBrush x:Key="Ink"         Color="#FFEDF2F3"/>
    <SolidColorBrush x:Key="InkMuted"    Color="#FF8FA8AF"/>
    <SolidColorBrush x:Key="Teal"        Color="#FF00A79A"/>
    <SolidColorBrush x:Key="TealDeep"    Color="#FF00786F"/>
    <SolidColorBrush x:Key="Mint"        Color="#FF99D1CD"/>
    <SolidColorBrush x:Key="Danger"      Color="#FFE0574E"/>
    <SolidColorBrush x:Key="Amber"       Color="#FFE8A33D"/>

    <!-- ===================================================== text -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Mint}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>

    <!-- ===================================================== inputs -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Mint}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource TealDeep}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
      <Setter Property="Padding" Value="11,5,11,5"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#FF2C6D7A"/>
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Teal}"/>
                <Setter TargetName="b" Property="Background" Value="#FF012B35"/>
              </Trigger>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FF001A20"/>
                <Setter Property="Foreground" Value="{StaticResource Mint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="11,5,11,5"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Margin" Value="0,0,18,6"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================================================== buttons -->
    <Style x:Key="BtnBase" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="18,0,18,0"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.86"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.70"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="{StaticResource TealDeep}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Teal}"/>
      <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="#FF03323C"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
      <Setter Property="Background" Value="#FF3D1512"/>
      <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
      <Setter Property="Foreground" Value="#FFFFC9C4"/>
      <Setter Property="MinWidth" Value="120"/>
    </Style>

    <!-- ===================================================== card -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ===================================================== results grid -->
    <Style x:Key="GridStyle" TargetType="DataGrid">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RowBackground" Value="#FF00232B"/>
      <Setter Property="AlternatingRowBackground" Value="#FF042E38"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="RowHeight" Value="22"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#FF063845"/>
      <Setter Property="Foreground" Value="{StaticResource Mint}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="10,7,10,7"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,0,10,0"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Background" Value="#FF00232B"/>
      <Setter Property="Foreground" Value="{StaticResource Teal}"/>
      <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="6"/>
    </Style>

  </Window.Resources>

  <!--  -->
  <!-- Everything is visible at once. Fields are paired two to a row so no      -->
  <!-- section is pushed off the screen. The ScrollViewer is only a safety net  -->
  <!-- for very small displays; at normal sizes nothing is hidden.              -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ================================================== HEADER -->
    <Border Grid.Row="0" Background="#FF002733" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,8,20,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="SCCM Integration" FontSize="20" FontWeight="Light" Foreground="{StaticResource Ink}"/>
          <TextBlock Text="Audi  &#183;  software packaging" FontSize="11" Foreground="{StaticResource InkMuted}" Margin="0,1,0,0"/>
        </StackPanel>

        <Border Grid.Column="2" x:Name="brdMode" CornerRadius="3" Background="#FF4A2E00" BorderBrush="{StaticResource Amber}"
                BorderThickness="1" Padding="10,4,10,4" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="txtMode" Text="SANDBOX" FontSize="11" FontWeight="Bold" Foreground="#FFFFD98A"/>
        </Border>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Environment" Foreground="{StaticResource InkMuted}" Margin="0,0,10,0"/>
          <ComboBox x:Name="cboEnvironment" Width="140"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================================================== CONTENT -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="20,6,20,6">

        <Border x:Name="brdWarning" CornerRadius="4" Background="#FF3A2A00" BorderBrush="{StaticResource Amber}"
                BorderThickness="1" Padding="14,9,14,9" Margin="0,0,0,12" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#9888;" FontSize="15" Foreground="{StaticResource Amber}" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <TextBlock x:Name="txtWarning" TextWrapping="Wrap" Foreground="#FFFFE8B8"/>
          </StackPanel>
        </Border>

        <!-- 1  THE PACKAGE -->
        <Border Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource SectionTitle}" Text="1 &#183; THE PACKAGE" Margin="0,0,0,7"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Package folder"/>
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtPackagePath" Margin="0,0,10,6"/>
            <Button    Grid.Row="1" Grid.Column="2" x:Name="btnBrowse" Style="{StaticResource BtnGhost}" Content="Browse&#8230;" MinWidth="104" Height="31" Margin="0,0,8,6"/>
            <Button    Grid.Row="1" Grid.Column="3" x:Name="btnRead"   Style="{StaticResource BtnPrimary}" Content="Read details" MinWidth="124" Height="31" Margin="0,0,0,6"
                       ToolTip="Reads the PSADT script and the install instruction document, and fills in what it finds."/>

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Package name"/>
            <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtPackage" FontFamily="Consolas" Margin="0"
                       ToolTip="Site_Publisher_Product_Architecture_Version_Revision_Language"/>
          </Grid>
        </Border>

        <!-- 2 and 3 -->
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- 2  read from the package -->
          <Border Grid.Column="0" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Style="{StaticResource SectionTitle}" Text="2 &#183; READ FROM THE PACKAGE" Margin="0,0,0,7" ToolTip="Derived from the package name and the package's own files. Not editable."/>
              

              <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Publisher"/>
              <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtPublisher" IsReadOnly="True"/>
              <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Label}" Text="Version"/>
              <TextBox   Grid.Row="2" Grid.Column="4" x:Name="txtVersion" IsReadOnly="True"/>

              <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Product"/>
              <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtProduct" IsReadOnly="True"/>
              <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource Label}" Text="Architecture"/>
              <TextBox   Grid.Row="3" Grid.Column="4" x:Name="txtArchitecture" IsReadOnly="True"/>

              <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="Revision"/>
              <TextBox   Grid.Row="4" Grid.Column="1" x:Name="txtRevision" IsReadOnly="True"/>
              <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource Label}" Text="Language"/>
              <TextBox   Grid.Row="4" Grid.Column="4" x:Name="txtLanguage" IsReadOnly="True"/>

              <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Label}" Text="Branding key"/>
              <TextBox   Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" x:Name="txtBranding" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Padding="11,3,11,3"/>

              <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Label}" Text="Detection key"/>
              <TextBox   Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" x:Name="txtDetection" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Padding="11,3,11,3" Margin="0"/>

              <Border Grid.Row="7" Grid.ColumnSpan="5" CornerRadius="4" Background="#FF00232B" BorderBrush="{StaticResource FieldBorder}"
                      BorderThickness="1" Padding="11,8,11,8" Margin="0,6,0,0">
                <TextBlock x:Name="txtSourceNote" TextWrapping="Wrap" FontSize="10.5" LineHeight="15"
                           Foreground="{StaticResource InkMuted}" Text="Nothing read yet."/>
              </Border>
            </Grid>
          </Border>

          <!-- 3  published in SCCM -->
          <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Stretch">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Style="{StaticResource SectionTitle}" Text="3 &#183; PUBLISHED IN SCCM" Margin="0,0,0,7" ToolTip="Check these before you submit. The RFC number is required."/>
              

              <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Name (EN)"/>
              <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtNameEN"/>
              <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Label}" Text="Name (DE)"/>
              <TextBox   Grid.Row="2" Grid.Column="4" x:Name="txtNameDE"/>

              <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Description (EN)" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,7,12,0"/>
              <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtDescEN" MinHeight="44" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
              <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource Label}" Text="Description (DE)" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,7,12,0"/>
              <TextBox   Grid.Row="3" Grid.Column="4" x:Name="txtDescDE" MinHeight="44" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>

              <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="RFC number"/>
              <TextBox   Grid.Row="4" Grid.Column="1" x:Name="txtRfc" FontFamily="Consolas"
                         ToolTip="Required. With no personal name kept on the server, the RFC is the only record of who asked for this change."/>

              <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Label}" Text="Operating systems" VerticalAlignment="Top" Margin="0,4,12,0" TextWrapping="Wrap"/>
              <WrapPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" x:Name="pnlOperatingSystems" Orientation="Horizontal" Margin="0,2,0,0"/>
            </Grid>
          </Border>
        </Grid>

        <!-- 4  RESULT -->
        <Border Style="{StaticResource CardStyle}" Margin="0,6,0,0" Padding="12,10,12,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,9">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="4 &#183; RESULT" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" x:Name="txtStep" Text="" FontWeight="SemiBold" Foreground="{StaticResource Mint}" FontSize="12"/>
            </Grid>
            <DataGrid Grid.Row="1" x:Name="lstResults" Style="{StaticResource GridStyle}" Height="100">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Step"   Width="160" Binding="{Binding Step}"/>
                <DataGridTextColumn Header="Result" Width="80"  Binding="{Binding Result}"/>
                <DataGridTextColumn Header="Detail" Width="*"   Binding="{Binding Message}"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ================================================== ACTIONS -->
    <Border Grid.Row="2" Background="#FF002733" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
            Padding="20,7,20,2">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button   Grid.Row="0" Grid.Column="0" x:Name="btnPreview"   Style="{StaticResource BtnGhost}"   Content="Preview on this PC" MinWidth="168"
                  ToolTip="Rehearses the whole job locally. Nothing is sent anywhere."/>
        <Button   Grid.Row="0" Grid.Column="1" x:Name="btnIntegrate" Style="{StaticResource BtnPrimary}" Content="Integrate"
                  ToolTip="Creates the application. Writes the job into the drop folder; the Script Runner picks it up."/>
        <Button   Grid.Row="0" Grid.Column="2" x:Name="btnModify"    Style="{StaticResource BtnGhost}"   Content="Modify"
                  ToolTip="Updates an application that already exists: new revision, new content path, added or retired collections and deployments."/>
        <Button   Grid.Row="0" Grid.Column="3" x:Name="btnRemove"    Style="{StaticResource BtnDanger}"  Content="Remove"
                  ToolTip="Removes the application, its collections, its deployments and the AD group. Needs only the package name and the RFC."/>
        <CheckBox Grid.Row="0" Grid.Column="5" x:Name="chkDryRun" IsChecked="True" FontWeight="SemiBold"
                  Content="Dry run &#8212; rehearse only, change nothing"/>

        <ProgressBar Grid.Row="1" Grid.ColumnSpan="6" x:Name="prgRun" Minimum="0" Maximum="8" Value="0" Margin="0,6,0,0"/>
      </Grid>
    </Border>

    <!-- ================================================== STATUS BAR -->
    <Border Grid.Row="3" Background="#FF001A20" Padding="20,7,20,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="txtStatus" Text="Ready." TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <Button    Grid.Column="1" x:Name="btnOpenLog" Style="{StaticResource BtnGhost}" Content="Open log folder"
                   MinWidth="146" IsEnabled="False" Margin="0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
