<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audi SCCM Integration Tool" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#FF002733"
        SizeToContent="Manual" ResizeMode="CanResize">

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFE5E9EB"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FF0B3A46"/>
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="BorderBrush" Value="#FF4C6870"/>
      <Setter Property="Padding" Value="4,3,4,3"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="4,3,4,3"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#FFE5E9EB"/>
      <Setter Property="Margin" Value="0,0,16,4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Foreground" Value="#FF99D1CD"/>
      <Setter Property="BorderBrush" Value="#FF4C6870"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Padding" Value="10"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6,14,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinWidth" Value="130"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*" MinHeight="300"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="1*" MinHeight="170"/>
    </Grid.RowDefinitions>

    <!-- ================================================== header -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="140"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="Environment" FontWeight="Bold"/>
      <ComboBox  Grid.Column="1" x:Name="cboEnvironment"/>
      <TextBlock Grid.Column="2" Text="Package name" FontWeight="Bold" Margin="14,0,8,0"/>
      <TextBox   Grid.Column="3" x:Name="txtPackage"/>
      <Button    Grid.Column="4" x:Name="btnBrowse"  Content="Browse package..." MinWidth="150" Margin="8,0,8,6"/>
      <Button    Grid.Column="5" x:Name="btnRead"    Content="Read details"      MinWidth="110" Margin="0,0,0,6"/>
    </Grid>

    <!-- ================================================== warning strip -->
    <Border Grid.Row="1" x:Name="brdWarning" Background="#FF6B4A00" BorderBrush="#FFFFC107"
            BorderThickness="1" Padding="10,6,10,6" Margin="0,0,0,10" Visibility="Collapsed">
      <TextBlock x:Name="txtWarning" TextWrapping="Wrap" Foreground="#FFFFF3CD"/>
    </Border>

    <!-- ================================================== body -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- left: what the package says -->
      <GroupBox Grid.Column="0" Header="Read from the package" Margin="0,0,7,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Publisher"/>
          <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtPublisher" IsReadOnly="True"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Product"/>
          <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtProduct" IsReadOnly="True"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Version"/>
          <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtVersion" IsReadOnly="True"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Architecture"/>
          <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtArchitecture" IsReadOnly="True"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="Revision"/>
          <TextBox   Grid.Row="4" Grid.Column="1" x:Name="txtRevision" IsReadOnly="True"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="Language"/>
          <TextBox   Grid.Row="5" Grid.Column="1" x:Name="txtLanguage" IsReadOnly="True"/>
          <TextBlock Grid.Row="6" Grid.Column="0" Text="Branding key"/>
          <TextBox   Grid.Row="6" Grid.Column="1" x:Name="txtBranding" IsReadOnly="True"/>
          <TextBlock Grid.Row="7" Grid.Column="0" Text="Detection key"/>
          <TextBox   Grid.Row="7" Grid.Column="1" x:Name="txtDetection" IsReadOnly="True"/>

          <TextBlock Grid.Row="8" Grid.ColumnSpan="2" x:Name="txtSourceNote" TextWrapping="Wrap"
                     Foreground="#FF99D1CD" VerticalAlignment="Top" Margin="0,8,0,0"/>
        </Grid>
      </GroupBox>

      <!-- right: what the operator supplies -->
      <GroupBox Grid.Column="1" Header="To be published in SCCM" Margin="7,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Name (EN)"/>
          <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtNameEN"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Name (DE)"/>
          <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtNameDE"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Description (EN)"/>
          <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtDescEN" MinHeight="46" TextWrapping="Wrap" AcceptsReturn="True"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Description (DE)"/>
          <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtDescDE" MinHeight="46" TextWrapping="Wrap" AcceptsReturn="True"/>
          <TextBlock Grid.Row="4" Grid.Column="0" Text="Install minutes"/>
          <TextBox   Grid.Row="4" Grid.Column="1" x:Name="txtEstimate"/>
          <TextBlock Grid.Row="5" Grid.Column="0" Text="RFC / order no."/>
          <TextBox   Grid.Row="5" Grid.Column="1" x:Name="txtRfc"/>

          <TextBlock Grid.Row="6" Grid.Column="0" Text="Operating systems" VerticalAlignment="Top" Margin="0,4,8,0"/>
          <WrapPanel Grid.Row="6" Grid.Column="1" x:Name="pnlOperatingSystems" Orientation="Horizontal"/>
        </Grid>
      </GroupBox>
    </Grid>

    <!-- ================================================== actions -->
    <Grid Grid.Row="3" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button   Grid.Column="0" x:Name="btnPreview"  Content="Preview (no changes)"  MinWidth="170"/>
      <Button   Grid.Column="1" x:Name="btnIntegrate" Content="Integrate"/>
      <Button   Grid.Column="2" x:Name="btnRemove"    Content="Remove"/>
      <CheckBox Grid.Column="4" x:Name="chkDryRun" Content="Dry run - make no changes" IsChecked="True" FontWeight="Bold"/>
    </Grid>

    <!-- ================================================== progress -->
    <Grid Grid.Row="4" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ProgressBar Grid.Column="0" x:Name="prgRun" Height="18" Minimum="0" Maximum="8" Value="0"/>
      <TextBlock   Grid.Column="1" x:Name="txtStep" Text="" Margin="10,0,0,0" FontWeight="Bold" Foreground="#FF99D1CD"/>
    </Grid>

    <!-- ================================================== results -->
    <Grid Grid.Row="5">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DataGrid Grid.Row="0" x:Name="lstResults" AutoGenerateColumns="False" IsReadOnly="True"
                Background="#FF0B3A46" Foreground="#FFFFFFFF" BorderBrush="#FF4C6870"
                RowBackground="#FF0B3A46" AlternatingRowBackground="#FF10454F"
                GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF4C6870"
                HeadersVisibility="Column" CanUserAddRows="False"
                HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Step"   Width="Auto" Binding="{Binding Step}"/>
          <DataGridTextColumn Header="Result" Width="Auto" Binding="{Binding Result}"/>
          <DataGridTextColumn Header="Detail" Width="*"    Binding="{Binding Message}"/>
        </DataGrid.Columns>
      </DataGrid>

      <Grid Grid.Row="1" Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="txtStatus" Text="Ready." TextWrapping="Wrap"/>
        <Button    Grid.Column="1" x:Name="btnOpenLog" Content="Open log folder" MinWidth="140" IsEnabled="False"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
