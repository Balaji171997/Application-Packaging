# ==============================================================================
#  Session configuration - the "service window" itself.
# ==============================================================================
#  This file is a RECIPE, read once at registration. Windows copies the settings
#  into its own store, so afterwards the file is not needed and may be deleted.
#  The endpoint is identified by its NAME, not by this file.
#
#  Two settings do the security work, and they are unrelated to each other:
#
#    GroupManagedServiceAccount   WHO DOES THE WORK
#    RoleDefinitions              WHO MAY CONNECT
#
#  The service account is not in the group, and the group has no rights of its
#  own. They meet only here.
#
#  Placeholders below are replaced by Install-AudiSwEndpoint.ps1.
#  Generated once with:  New-PSSessionConfigurationFile -Path .\AudiSwIntegration.pssc
# ==============================================================================
@{
    SchemaVersion       = '2.0.0.0'
    GUID                = 'c7b9e148-2a63-4f0d-8e51-3b6f9a2c4d70'
    Author              = 'Digital Workplace and Cross Functional Services (I-DI-D)'
    Description         = 'Audi SCCM software integration endpoint'

    # Restricted remote server: the caller gets no language, no providers, and
    # only the commands named in the role capability file.
    SessionType         = 'RestrictedRemoteServer'
    LanguageMode        = 'NoLanguage'
    ExecutionPolicy     = 'RemoteSigned'

    # The work runs as this account. Its password is created and rotated by
    # Active Directory and is never seen, typed or stored by anyone.
    GroupManagedServiceAccount = '__GMSA__'
    RunAsVirtualAccount = $false

    # Who may connect, and what they may run once connected.
    RoleDefinitions     = @{
        '__OPERATORGROUP__' = @{ RoleCapabilities = 'AudiSwIntegration' }
    }

    # Every session is recorded, independently of the tool's own log.
    TranscriptDirectory = '__TRANSCRIPTS__'

    # Only the engine module is loaded into the session.
    ModulesToImport     = @('AudiSwIntegration')
}
