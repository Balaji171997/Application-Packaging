<?xml version="1.0" encoding="utf-8"?>
<!--
  Values that are identical in ICZ, INA and PCZ.

  In the tool being replaced these values were repeated in all 36 environment
  files and in the script itself. Three copies of the same value drift apart,
  which is how PCZ ended up holding INA's security scope, application folder and
  content path. They are held once here instead.

  Regex patterns below use \x22 for a double quote so the XML stays readable.
-->
<Defaults schemaVersion="1.0">

  <!-- What the deployment type runs. repair="" leaves the Repair command empty,
       which is what the old tool did - it had no <RepairCommandline> at all.
       PSADT supports it, so it is offered here as one edit. -->
  <Commands install="Invoke-AppDeployToolkit.exe Install"
            uninstall="Invoke-AppDeployToolkit.exe Uninstall"
            repair="Invoke-AppDeployToolkit.exe Repair"/>

  <!--
    The application's Distribution Settings tab in the console.

    onDemand="true"          "Enable for on-demand distribution" - when a client
                             asks for content that is not on its distribution
                             point, distribute it there on demand. Their tool set
                             this; ours did not, which is why the tick box was
                             empty on the application it made.

    prestaged="AutoDownload" the "Prestaged distribution point settings" radio:
                               AutoDownload               automatically download
                               DownloadOnlyContentChange  changes only
                               ManualCopy                 copy it by hand
                             ManualCopy is what SCCM defaults to, and it is why
                             the third radio was selected on ours.
  -->
  <Distribution onDemand="true" prestaged="AutoDownload"/>

  <!--
    Steps that can be switched off for every environment at once.

    createArsGroup="false" - the Active Directory access group is NOT created.

    On the first real run that reached it, the directory refused the request:

        malformedRequest - Some of the specified attributes for the 'group'
        object class are not defined in the schema.

    Everything in SCCM is finished and correct by the time this step runs, so
    letting it fail would roll a good application back out over a step nobody
    can use yet. The step still RUNS and still reports - as SKIPPED, saying the
    group was not created - so nobody is left believing it exists.

    To turn it back on: settle the attribute names with whoever owns the ARS
    schema (the old tool sent 'description' and 'edsva-Auftragsnummer'), then
    set this to true. Nothing else changes.
  -->
  <Steps createArsGroup="false"/>

  <Naming brandingRegistryRoot="Software\VWG\CM\"
          deploymentTypeSuffix="_INSTALLCOMPUTER"
          arsGroupPrefix="G-AUDI-AG-SW-"
          arsDescriptionPrefix="Software-Filtergroups - "/>

  <Application category="Development"
               maxRuntimeMinutes="120"
               estimatedInstallMinutes="3"
               defaultLanguage="en-us"/>

  <!--
    TWO detection rules, both of which must be true.

    Rule 1 - the branding key the package itself writes:
        HKLM\Software\VWG\CM\<branding key>   Revision = <revision>
      There is no separate "detection key" to keep in step: the branding key IS
      the rule, with brandingRegistryRoot in front of it.

    Rule 2 - the product's own uninstall entry, taken from VWG_SoftIdent in the
      deployment script, e.g.
        HKLM:\SOFTWARE\$($VWG_CurrentRegWOW)Microsoft\...\INCA7.5.7 [DisplayVersion=7.5.7]
      The script's own Wow6432Node placeholder decides 32-bit or 64-bit, so the
      package tells us which view it lives in and we never guess. is64Bit stays
      true because the resolved path already contains Wow6432Node when the
      package is 32-bit, and that node exists only in the 64-bit view.

    A package with no SoftIdent, or one written in a shape the pattern does not
    recognise, simply gets rule 1.
  -->
  <Detection valueName="Revision" dataType="String" is64Bit="true" method="Value"/>

  <SoftIdentDetection dataType="String" is64Bit="true" method="Value"
                      pattern="^\s*(?'Hive'HK[A-Za-z_]+):?\\(?'Key'[^\[]+?)\s*(?:\[\s*(?'ValueName'[^=\]]+?)\s*=\s*(?'Value'[^\]]*?)\s*\])?\s*$"/>

  <DeploymentType distributionPointSetting="AutoDownload"
                  slowNetworkDeploymentMode="Download"
                  programVisibility="Hidden"
                  installationBehaviorType="InstallForSystem"
                  logonRequirementType="WhetherOrNotUserLoggedOn"
                  allowClientToShareContent="false"
                  allowClientToUseFallback="true"
                  persistContentInClientCache="false"
                  run32BitOn64Bit="false"/>

  <!-- Windows 7 is out of support and no longer packaged for, so it is not
       offered. Adding an operating system back is one line here, not a code
       change. -->
  <OperatingSystems>
    <OperatingSystem key="Win10x64" label="Windows 10 x64"
                     value="Windows/All_x64_Windows_10_and_higher_Clients" selectedByDefault="true"/>
    <OperatingSystem key="Win11x64" label="Windows 11 x64"
                     value="Windows/All_x64_Windows_11_and_higher_Clients" selectedByDefault="false"/>
  </OperatingSystems>

  <!-- Stamped onto every collection the tool creates. The old tool wrote
       "created by manual MCB script", which said nothing useful.

       NO PERSONAL NAME APPEARS HERE, BY REQUIREMENT.
       Audi does not want the requester's name written to any SCCM object. The
       job ID is the link instead: it is recorded here, and the tool's own log
       on the server maps that job ID back to the person who asked. Anyone
       auditing an object in the console looks up the job ID.

       {requester} is deliberately NOT available as a placeholder. Putting it
       back into this template does not work - the tool rejects the config file
       at load with an explanation, so the rule cannot be undone by an edit on
       the server. Available placeholders: {package} {jobId} {rfc} -->
  <Comments collection="Created by the SCCM Integration Tool | job {jobId} | RFC {rfc}"
            application="Created by the SCCM Integration Tool | job {jobId} | RFC {rfc}"/>

  <!-- No personal name is kept anywhere on the SCCM side, so the RFC number is
       the ONLY route from an object in the console back to the person who asked
       for it - through Audi's change system, which is where that link belongs.

       That makes an empty RFC an audit gap rather than a cosmetic omission, so
       jobs without one are refused. Set requireRfc="false" only if Audi accepts
       changes that can never be traced to a requester. -->
  <Audit requireRfc="true"/>

  <!-- Package name layout.

       A real Audi package folder is the SITE CODE followed by the branding key:
           INA_ETAS_INCA_x64_7.5.7-0001_MUL
           ^^^ ^^^^ ^^^^ ^^^ ^^^^^ ^^^^ ^^^
           |   |    |    |   |     |    language
           |   |    |    |   |     revision      <- joined to the version by '-'
           |   |    |    |   version
           |   |    |    architecture
           |   |    product      <- may itself contain '_'
           |   publisher
           site

       Each pattern is tried in order and the first that matches wins, so more
       than one naming convention can be supported at once without a code
       change. Named groups use the (?'Name'...) form so no XML escaping is
       needed. Every group named here becomes a field the window can show. -->
  <PackageName separator="_"
               brandingKeyFormat="{Publisher}_{Product}_{Architecture}_{Version}-{Revision}_{Language}">

    <!-- current form: version and revision joined by a hyphen -->
    <Pattern>^(?'Site'[^_]+)_(?'Publisher'[^_]+)_(?'Product'.+)_(?'Architecture'[^_]+)_(?'Version'[^_]+)-(?'Revision'[^_-]+)_(?'Language'[^_]+)$</Pattern>

    <!-- older form: revision as a part of its own -->
    <Pattern>^(?'Site'[^_]+)_(?'Publisher'[^_]+)_(?'Product'.+)_(?'Architecture'[^_]+)_(?'Version'[^_]+)_(?'Revision'[^_]+)_(?'Language'[^_]+)$</Pattern>
  </PackageName>

  <!-- Where the packager window fills itself from, so nothing already recorded
       in the package has to be retyped. Anything that does not match is simply
       left blank and the packager completes it by hand. -->
  <PackageSource searchDepth="3">

    <!-- PSADT v4: values live in the $adtSession hashtable. -->
    <Script generation="v4" fileName="Invoke-AppDeployToolkit.ps1">
      <Field name="Publisher"    pattern="AppVendor\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="Product"      pattern="AppName\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="Version"      pattern="AppVersion\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="Architecture" pattern="AppArch\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="Language"     pattern="AppLang\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="Revision"     pattern="AppRevision\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="ScriptAuthor" pattern="AppScriptAuthor\s*=\s*['\x22]([^'\x22]*)['\x22]"/>

      <!-- lastMatchWins (the default) is what makes SoftIdent correct.
           VWG_SoftIdent is declared twice: once in the standard block and again
           in CUSTOM APPLICATION VARIABLES. Only the second carries
           $(VWG_CurrentRegWOW) - Wow6432Node for a 32-bit application on 64-bit
           Windows - so the last match must win.
           The names are the same in v3 and v4, so one pattern serves both. -->
      <Field name="SoftIdent"    pattern="VWG_SoftIdent\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="OrderNumber"  pattern="VWG_OrderNumber\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="Portfolio"    pattern="VWG_Portfv\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
    </Script>

    <!-- PSADT v3: values are plain variables at the top of the script. -->
    <Script generation="v3" fileName="Deploy-Application.ps1">
      <Field name="Publisher"    pattern="\$appVendor\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="Product"      pattern="\$appName\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="Version"      pattern="\$appVersion\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="Architecture" pattern="\$appArch\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="Language"     pattern="\$appLang\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="Revision"     pattern="\$appRevision\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="ScriptAuthor" pattern="\$appScriptAuthor\s*=\s*['\x22]([^'\x22]*)['\x22]"/>

      <!-- lastMatchWins (the default) is what makes SoftIdent correct.
           VWG_SoftIdent is declared twice: once in the standard block and again
           in CUSTOM APPLICATION VARIABLES. Only the second carries
           $(VWG_CurrentRegWOW) - Wow6432Node for a 32-bit application on 64-bit
           Windows - so the last match must win.
           The names are the same in v3 and v4, so one pattern serves both. -->
      <Field name="SoftIdent"    pattern="VWG_SoftIdent\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="OrderNumber"  pattern="VWG_OrderNumber\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
      <Field name="Portfolio"    pattern="VWG_Portfv\s*=\s*['\x22]([^'\x22]*)['\x22]"/>
    </Script>

    <!-- The "Software Package Request" document that ships with the package.

         CALIBRATED against a real Audi request form (INA_ETAS_INCA). That form
         is a TABLE: the label sits on one line and the value on the NEXT one,
         indented by a tab. So these patterns match a label line and then take
         the line below it - not "label: value" on a single line.

         [ \t] is used rather than \s so the match cannot run past the following
         line and swallow the next label.

         Anything that does not match is simply left blank for the packager to
         type. Adjusting a label is an edit here, not a code change. -->
    <Document filter="*.docx">
      <!-- THE DESCRIPTION, AND NOTHING ELSE.
           Everything else comes from the deployment script, which is the
           reliable source. The document is only consulted for the wording a
           user will read in Software Center.

           Order of preference, per language:
             1. Short description of the product
             2. Detailed description of the product   (used only if 1 is empty)
             3. nothing here - the window falls back to "Publisher - Product -
                Version", the way it has always been done

           If Audi later wants more from this form, add fields here. -->
      <Field name="ApplicationDescriptionEN"     pattern="(?im)^[ \t]*Short description of the product in English[ \t]*\r?\n[ \t]*(.+?)[ \t]*$"/>
      <Field name="ApplicationDescriptionDE"     pattern="(?im)^[ \t]*Short description of the product in German[ \t]*\r?\n[ \t]*(.+?)[ \t]*$"/>
      <Field name="ApplicationDescriptionENLong" pattern="(?im)^[ \t]*Detailed description of the product in English[ \t]*\r?\n[ \t]*(.+?)[ \t]*$"/>
      <Field name="ApplicationDescriptionDELong" pattern="(?im)^[ \t]*Detailed description of the product in German[ \t]*\r?\n[ \t]*(.+?)[ \t]*$"/>

      <!-- The supported operating systems, as ticked on the form. A field named
           OperatingSystem:<key> ticks the matching box in the window. The key
           must match an <OperatingSystem key="..."> above. -->
      <Field name="OperatingSystem:Win10x64" pattern="(&#9746;)[ \t]*Windows 10"/>
      <Field name="OperatingSystem:Win11x64" pattern="(&#9746;)[ \t]*Windows 11"/>
    </Document>

  </PackageSource>

  <!-- Operational behaviour.

       The tool being replaced waited a flat 30 seconds after each deployment and
       never retried anything. Here the waiting is a real check with a timeout,
       and only failures matching TransientErrors are retried - anything else
       fails immediately, so a genuine error is not buried under retries.

       logRoot is per job: <logRoot>\<environment>\<package>\<jobId>. -->
  <Runtime retryCount="3"
           retryDelaySeconds="5"
           distributionTimeoutMinutes="30"
           distributionPollSeconds="20"
           logRoot="%ProgramData%\Audi\SwIntegration\Logs"
           logRetentionDays="180"
           lockTimeoutMinutes="60">
    <TransientErrors>
      <Pattern>RPC server is unavailable</Pattern>
      <Pattern>The operation timed out</Pattern>
      <Pattern>is busy|being used by another</Pattern>
      <Pattern>Generic failure</Pattern>
      <Pattern>transport connection|connection was closed</Pattern>
      <Pattern>SMS Provider|provider is not available</Pattern>
      <Pattern>deadlock|timeout expired</Pattern>
    </TransientErrors>
  </Runtime>

</Defaults>
