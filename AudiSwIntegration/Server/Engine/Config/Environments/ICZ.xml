<?xml version="1.0" encoding="utf-8"?>
<!--
  ICZ - test environment.
  Values taken from EQS-PoshGUI-Tool-1.0.3\ICZ\*.xml and from the site block in
  EQS-PoshGUI-Tool-1.0.3.ps1.

  Service/@account and Service/@allowedGroup are placeholders until Audi's AD
  team creates them; they are recorded here so the tool can name them in an
  error message rather than failing silently.
-->
<Environment code="ICZ" description="Test" schemaVersion="1.0" verified="true">

  <Domain logonPrefix="deaudi005t\">
    <Name>audi.vwg5t</Name>
  </Domain>

  <Site code="ICZ" server="AUDIINSA1298.audi.vwg5t"/>

  <!-- CONFIRM: the machine that runs the collector task (Zone: Global). -->
  <Runner host="AUDIINSA1298.audi.vwg5t"/>
  <Service account="MN-MAN\AW140"
           allowedGroup="MN-MAN\AW140"/>

  <!-- Direct today. Switch mode to DropFolder and fill in dropFolder to use flow 2. -->
